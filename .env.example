# Local development (`npm run local`) needs none of these; safe defaults apply.

# Required in production. Use a random string of at least 32 characters,
# e.g. `openssl rand -hex 32`.
COOKIE_SECRET=

# Port the API/app listens on. Railway injects this automatically.
# In `npm run local` the API listens on 3001 and Vite on 5173.
PORT=3000

# Directory for game.sqlite. Railway's RAILWAY_VOLUME_MOUNT_PATH takes precedence.
# Defaults to ./.data locally and /data in the Docker image.
DATA_DIR=

# Defaults to true in production. Set to false only for plain-HTTP local runs.
COOKIE_SECURE=
